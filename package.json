{
  "name": "hema-furniture",
  "version": "0.93.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "worker": "tsx src/workers/emailWorker.ts",
    "test": "jest --passWithNoTests --forceExit",
    "test:unit": "jest --testPathPattern=\"unit\" --passWithNoTests --forceExit",
    "test:int": "jest --testPathPattern=\"integration\" --passWithNoTests --forceExit",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --passWithNoTests --forceExit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test:unit && npm run test:int && npm run test:e2e",
    "test:all:ci": "jest --coverage --passWithNoTests --forceExit --detectOpenHandles",
    "test:watch-unit": "jest --testPathPattern=\"unit\" --watch",
    "test:load:smoke": "k6 run load-tests/smoke.js",
    "test:load": "k6 run load-tests/load.js",
    "test:load:stress": "k6 run load-tests/stress.js",
    "analyze": "ANALYZE=true npm run build",
    "docker:build": "DOCKER_BUILD=true npm run build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "backup": "bash scripts/backup.sh",
    "backup:dry": "bash scripts/backup.sh --dry-run",
    "migrate:bcrypt": "tsx scripts/migrate-bcrypt-to-argon2.ts",
    "migrate:bcrypt:dry": "DRY_RUN=true tsx scripts/migrate-bcrypt-to-argon2.ts"
  },
  "overrides": {
    "whatwg-encoding": "1.0.5",
    "html-encoding-sniffer": "2.0.1",
    "whatwg-url": "11.0.0",
    "jsdom": "20.0.3"
  },
  "dependencies": {
    "@hookform/resolvers": "3.10.0",
    "@node-rs/argon2": "2.0.0",
    "@sentry/nextjs": "9.0.0",
    "@vercel/analytics": "1.6.0",
    "@vercel/speed-insights": "1.3.0",
    "cloudinary": "2.6.0",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "ioredis": "5.4.2",
    "isomorphic-dompurify": "^2.17.0",
    "mongoose": "8.9.0",
    "next": "15.3.9",
    "next-auth": "5.0.0-beta.28",
    "nodemailer": "7.0.7",
    "otplib": "12.0.1",
    "qrcode": "1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.54.0",
    "react-hot-toast": "2.5.2",
    "sharp": "0.33.5",
    "slugify": "1.6.6",
    "swr": "2.3.0",
    "tailwind-merge": "2.6.0",
    "uuid": "11.0.0",
    "zod": "3.24.0",
    "zustand": "5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.50.0",
    "@testing-library/jest-dom": "6.6.0",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "14.5.2",
    "@types/dompurify": "3.0.5",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "autoprefixer": "10.4.20",
    "dotenv": "16.4.7",
    "eslint": "9.18.0",
    "eslint-config-next": "15.3.9",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-environment-node": "29.7.0",
    "mongodb-memory-server": "10.1.0",
    "postcss": "8.5.0",
    "tailwindcss": "3.4.19",
    "ts-jest": "29.4.9",
    "ts-node": "10.9.2",
    "tsx": "4.19.0",
    "typescript": "5.9.3"
  },
  "optionalDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.600.0"
  }
}

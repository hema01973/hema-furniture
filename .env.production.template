# NEVER commit real secrets. This file is placeholders only.
# Generate secrets with: openssl rand -base64 48
#
# ── Core Runtime ───────────────────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://hemafurniture.com
NEXTAUTH_URL=https://hemafurniture.com
LOG_LEVEL=info
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
# LOW-04 FIX (V065): Permission-version cache TTL in seconds (default: 30).
# Lower values = faster role revocation + more Redis/DB round-trips per request.
# Higher values = slower revocation + fewer queries (better for high traffic).
# Minimum: 1. Recommended range: 5–60. Set to 5 during active incident response.
PV_CACHE_TTL_SEC=30
#
# ── Database (cloud.mongodb.com) ───────────────────────────────────────────────
MONGODB_URI=mongodb+srv://REPLACE_DB_USER:REPLACE_DB_PASS@cluster0.example.mongodb.net/hema
MONGODB_POOL_SIZE=10
MONGODB_SELECTION_MS=10000
MONGODB_SOCKET_MS=45000
#
# ── Auth / Secrets ─────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=REPLACE_WITH_STRONG_SECRET
# MED-02 FIX (V066): Independent secret for guest order claim tokens.
# Allows NEXTAUTH_SECRET rotation without invalidating outstanding 7-day claim tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLAIM_TOKEN_SECRET=REPLACE_WITH_STRONG_SECRET
CRON_SECRET=REPLACE_WITH_STRONG_SECRET
METRICS_SECRET=REPLACE_WITH_STRONG_SECRET
#
# ── Audit Log HMAC (REQUIRED in production — HIGH-05 FIX V064) ────────────────────────────
# REQUIRED: Without this, audit log HMAC signatures are skipped — the process will
# throw a fatal error at startup in NODE_ENV=production if this is not set.
# Entries can be tampered without detection when HMAC secret is absent.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Store in AWS Secrets Manager — never commit the real key.
AUDIT_HMAC_SECRET=<REPLACE_WITH_64_HEX_CHARS>
#
# ── Redis (Upstash rediss://) ─────────────────────────────────────────────────
REDIS_URL=rediss://default:REPLACE_REDIS_PASSWORD@your-upstash-endpoint.upstash.io:6379
#
# ── Email / SMTP ───────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=REPLACE_SMTP_PASSWORD
EMAIL_FROM="Hema Furniture" <no-reply@hemafurniture.com>
ADMIN_ALERT_EMAIL=alerts@hemafurniture.com
#
# ── Cloudinary (cloudinary.com) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=REPLACE_CLOUDINARY_CLOUD
CLOUDINARY_API_KEY=REPLACE_CLOUDINARY_KEY
CLOUDINARY_API_SECRET=REPLACE_CLOUDINARY_SECRET
#
# ── Paymob (accept.paymob.com) ────────────────────────────────────────────────
# Step-by-step: use STAGING keys first, then swap to production keys before go-live.
PAYMOB_API_KEY=REPLACE_PAYMOB_API_KEY
PAYMOB_INTEGRATION_ID=REPLACE_PAYMOB_INTEGRATION_ID
PAYMOB_IFRAME_ID=REPLACE_PAYMOB_IFRAME_ID
PAYMOB_HMAC_SECRET=REPLACE_PAYMOB_HMAC_SECRET
#
# ── Monitoring ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://REPLACE_INGEST@o0.ingest.sentry.io/0

# ── CSP Reporting (VULN-05) ────────────────────────────────────────────────
CSP_REPORT_URI=https://hemafurniture.com/api/csp-report

# ── Email Queue ───────────────────────────────────────────────────
# OPTIONAL: Set for durable serverless email queuing via Upstash QStash.
# Without it, in-process retry queue is used (5 attempts, exponential backoff).
# QSTASH_TOKEN=
# QSTASH_URL=https://qstash.upstash.io/v2/publish/

# ── App Version ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_VERSION=0.69.0
ROTATION_WEBHOOK_SECRET=REPLACE_WITH_STRONG_SECRET

# ── MFA Encryption (CRIT-01 — REQUIRED in production) ──────────────────────────
# AES-256-GCM key for TOTP secret at-rest encryption (OWASP ASVS §2.8.7).
# WITHOUT THIS: MFA secrets stored plaintext — DB breach = total MFA bypass for all users.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Store in AWS Secrets Manager — never commit the real key.
MFA_ENCRYPTION_KEY=<REPLACE_WITH_64_HEX_CHARS>

# ── Durable Email Queue (CRIT-02 — REQUIRED in production) ─────────────────────
# WITHOUT THIS: queued emails (order confirmations, password resets) are LOST on
# restart or cold start. On Vercel, cold starts are frequent — data loss is certain.
# Get token at: https://upstash.com/docs/qstash
QSTASH_TOKEN=<REPLACE_WITH_QSTASH_TOKEN>
QSTASH_URL=https://qstash.upstash.io/v2/publish/

# ── Paymob IP Allowlist (Optional override) ────────────────────────────────────
# Override default Paymob IP ranges (197.48.96.0/19, 37.18.32.0/21).
# Comma-separated CIDR list. Leave empty to use built-in defaults.
# PAYMOB_ALLOWED_IPS=197.48.96.0/19,37.18.32.0/21

# ── V068 SECURITY ADDITIONS ──────────────────────────────────────────────────
# VULN-001 FIX: QStash cryptographic signature verification (REQUIRED in production)
QSTASH_CURRENT_SIGNING_KEY=<REPLACE_WITH_QSTASH_CURRENT_SIGNING_KEY>
QSTASH_NEXT_SIGNING_KEY=<REPLACE_WITH_QSTASH_NEXT_SIGNING_KEY>

# VULN-002 FIX: Dedicated newsletter unsubscribe token secret (independent rotation)
NEWSLETTER_UNSUBSCRIBE_SECRET=<REPLACE_WITH_NEWSLETTER_UNSUBSCRIBE_SECRET_MIN_32_CHARS>

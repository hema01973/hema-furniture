# .env.example — HemaV062
# Complete environment variable reference.
# Copy to .env.local for development.

# ── App ───────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Hema Furniture

# ── Auth (NextAuth v5) ────────────────────────────────────────────
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars
# MED-02 FIX (V066): Dedicated secret for guest order claim tokens — independent rotation schedule.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If not set, falls back to NEXTAUTH_SECRET (backward-compatible).
CLAIM_TOKEN_SECRET=your-claim-token-secret-min-32-chars
# LOW-04 FIX (V054): AES-256-GCM key for mfaSecret at-rest encryption (OWASP ASVS §2.8.7)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Store in AWS Secrets Manager in production — never commit the real key.
MFA_ENCRYPTION_KEY=your-64-hex-char-encryption-key-here
NEXTAUTH_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/hema-furniture
MONGODB_POOL_SIZE=10
MONGODB_SELECTION_MS=10000
MONGODB_SOCKET_MS=45000

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Cloudinary ────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Email (SMTP) ──────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
SMTP_FROM=Hema Furniture <noreply@hemafurniture.com>

# ── Payment (Paymob) ──────────────────────────────────────────────
PAYMOB_API_KEY=your-paymob-api-key
PAYMOB_INTEGRATION_ID=your-integration-id
PAYMOB_IFRAME_ID=your-iframe-id
PAYMOB_HMAC_SECRET=your-hmac-secret

# ── Monitoring ────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_ORG=your-org
SENTRY_PROJECT=hema-furniture
SENTRY_AUTH_TOKEN=your-sentry-auth-token
CSP_REPORT_URI=https://your-csp-endpoint.com/report

# ── Audit Log ─────────────────────────────────────────────────────
AUDIT_LOG_TTL_SECONDS=31536000

# ── Feature Flags (env-var overrides) ────────────────────────────
# FEATURE_FLAG_MAINTENANCE_MODE=false
# FEATURE_FLAG_GUEST_CHECKOUT=true
# FEATURE_FLAG_DARK_MODE=true
# FEATURE_FLAG_LOYALTY_PROGRAM=false

# ── AWS Secrets Manager (production) ─────────────────────────────
# USE_AWS_SECRETS=false
# AWS_REGION=us-east-1
# AWS_SECRET_NAME=hema/production/secrets

# ── Vercel (CI/CD — set in GitHub Actions secrets) ───────────────
# VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID
# MONGODB_URI_TEST, MONGODB_URI_STAGING, MONGODB_URI_PRODUCTION
# REDIS_URL_STAGING, REDIS_URL_PRODUCTION
# CODECOV_TOKEN

# ── Email Queue ───────────────────────────────────────────────────
# OPTIONAL: Upstash QStash for durable serverless email queuing.
# If not set, the system uses an in-process retry queue (free, any host).
# QSTASH_TOKEN=your_upstash_qstash_token
# VULN-002 FIX (V068): Dedicated secret for newsletter unsubscribe HMAC tokens.
# Allows independent rotation from NEXTAUTH_SECRET without invalidating outstanding
# 30-day unsubscribe links. Fallback: NEXTAUTH_SECRET (for backward compat).
# NEWSLETTER_UNSUBSCRIBE_SECRET=your_newsletter_unsubscribe_secret_min_32_chars

# QSTASH_URL=https://qstash.upstash.io/v2/publish/

# ── App Version ────────────────────────────────────────────────────
# Used by Sentry to tag releases for error correlation across deployments.
# Should match the version in package.json (set automatically by CI/CD).
NEXT_PUBLIC_APP_VERSION=0.69.0

# ── Secrets Rotation Webhook ───────────────────────────────────────
# Required when SECRETS_PROVIDER=aws and AWS SM rotation is active.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ROTATION_WEBHOOK_SECRET=your-rotation-webhook-secret

# ── Admin Alerts ───────────────────────────────────────────────────
# Receives authz-burst / admin payment failure alert emails.
ADMIN_ALERT_EMAIL=admin@hemafurniture.com

# ── V062 New Variables ────────────────────────────────────────────
# MFA_ENCRYPTION_KEY — REQUIRED in production (CRIT-01 FIX)
# Optional in development/test. Must be exactly 64 hex chars (256-bit AES-256-GCM key).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MFA_ENCRYPTION_KEY=your-64-hex-char-key-here

# QSTASH_TOKEN — REQUIRED in production (CRIT-02 FIX)
# Enables durable email queuing via Upstash QStash. Without it, emails are lost on restart.
# QSTASH_TOKEN=your_qstash_token
# VULN-001 FIX (V068): REQUIRED for cryptographic QStash signature verification.
# Get from Upstash Console → QStash → Signing Keys.
# QSTASH_CURRENT_SIGNING_KEY=your_current_signing_key
# QSTASH_NEXT_SIGNING_KEY=your_next_signing_key


# PAYMOB_ALLOWED_IPS — Optional (MED-04 FIX)
# Override the built-in Paymob IP CIDR allowlist (197.48.96.0/19, 37.18.32.0/21).
# PAYMOB_ALLOWED_IPS=197.48.96.0/19,37.18.32.0/21

# AUDIT_HMAC_SECRET — REQUIRED in production (HIGH-005 FIX V069)
# Without this, the audit log chain can be tampered with — PCI-DSS violation.
# HMAC key for audit log entry signing. Without it chain hashes work but HMAC is skipped.
AUDIT_HMAC_SECRET=your-32+-char-secret
